# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geopolitics
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=your-openai-api-key-here

# Telegram scraping (optional — app works without these)
# Get API credentials at https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Generate session string: python backend/scripts/generate_telegram_session.py
TELEGRAM_SESSION=
# Comma-separated channel usernames to scrape
TELEGRAM_CHANNELS=FrontlineReportNews,BellumActaNews,rnintel

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-api-key-here
# Used when no MapTiler key is set; free key at https://carto.com/basemaps/apikey. With neither, OpenFreeMap is used
NEXT_PUBLIC_CARTO_API_KEY=
